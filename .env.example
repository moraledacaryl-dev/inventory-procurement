APP_ENV=development
APP_NAME=Hidden Oasis Inventory & Procurement
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://inventory:inventory@db:5432/inventory
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
MAX_REQUEST_BYTES=10485760
BACKUP_MAX_AGE_HOURS=48
BOOTSTRAP_OWNER_EMAIL=owner@hiddenoasis.local
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_PASSWORD=change-this-password-now

# Inbound integration credentials accepted by Inventory.
STAFF_INTEGRATION_TOKEN=replace-with-staff-integration-token
COMMAND_CENTER_INTEGRATION_TOKEN=replace-with-command-center-integration-token
ACCOUNTING_INTEGRATION_TOKEN=replace-with-accounting-integration-token
POS_INTEGRATION_TOKEN=replace-with-pos-integration-token

# Outbound integration destinations used by the durable worker.
INTEGRATION_ENDPOINTS_JSON={"accounting":"https://accounting.hiddenoasis.app","operations":"https://operations.hiddenoasis.app"}
INTEGRATION_API_KEY=replace-with-accounting-integration-secret
OPERATIONS_INTEGRATION_KEY=replace-with-operations-integration-secret

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKUP_DIR=/backups
