APP_ENV=production
APP_NAME=Hidden Oasis Inventory & Procurement
API_V1_PREFIX=/api/v1

POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://inventory:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/inventory

JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=["https://inventory.hiddenoasis.app"]
TRUSTED_HOSTS=["inventory.hiddenoasis.app"]
MAX_REQUEST_BYTES=10485760
BACKUP_MAX_AGE_HOURS=48

BOOTSTRAP_OWNER_EMAIL=REPLACE_WITH_YOUR_OWNER_EMAIL
BOOTSTRAP_OWNER_NAME=Caryl Moraleda
BOOTSTRAP_OWNER_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_OWNER_PASSWORD

# Inbound credentials used by Staff, Operations, Accounting, and POS when posting to Inventory.
STAFF_INTEGRATION_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STAFF_INTEGRATION_TOKEN
COMMAND_CENTER_INTEGRATION_TOKEN=REPLACE_WITH_A_LONG_RANDOM_COMMAND_CENTER_INTEGRATION_TOKEN
ACCOUNTING_INTEGRATION_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ACCOUNTING_INTEGRATION_TOKEN
POS_INTEGRATION_TOKEN=REPLACE_WITH_A_LONG_RANDOM_POS_INTEGRATION_TOKEN

# Outbound durable-worker destinations and dedicated credentials.
INTEGRATION_ENDPOINTS_JSON={"accounting":"https://accounting.hiddenoasis.app","operations":"https://operations.hiddenoasis.app"}
INTEGRATION_API_KEY=REPLACE_WITH_THE_ACCOUNTING_INTEGRATION_API_KEY
OPERATIONS_INTEGRATION_KEY=REPLACE_WITH_THE_OPERATIONS_INTEGRATION_API_KEY

BACKUP_DIR=/backups
